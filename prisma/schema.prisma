generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  image     String?
  order     Int      @default(0)
  parentId  String?
  parent    Category?  @relation("Subcategories", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("Subcategories")
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceYER    Float
  images      String   @default("[]")
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  featured    Boolean  @default(false)
  inStock     Boolean  @default(true)
  tags        String   @default("[]")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            String   @id @default(cuid())
  items         String   @default("[]")
  totalYER      Float
  discountYER   Float    @default(0)
  couponId      String?
  currency      String   @default("YER")
  customerName  String
  customerPhone String
  customerCity  String?
  customerNotes String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  coupon        Coupon?  @relation(fields: [couponId], references: [id])
}

model CurrencyRate {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  rateToYER Float
  symbol    String
  updatedAt DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  type           String   @default("percentage")
  value          Float
  minOrderAmount Float    @default(0)
  maxUses        Int?
  usedCount      Int      @default(0)
  isActive       Boolean  @default(true)
  allProducts    Boolean  @default(true)
  productIds     String   @default("[]")
  categoryIds    String   @default("[]")
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
}
